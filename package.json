{
	"name": "mongo-typed",
	"version": "1.7.1",
	"description": "Provides type-safe MongoDB-style query and update utilities in TypeScript. It is designed to assist with building fully-typed data repository layers or services that interact with MongoDB-like syntax, without relying on external libraries or runtime packages.",
	"author": "SecureDataSystems",
	"license": "MIT",
	"repository": {
    "type": "git",
    "url": "git+https://github.com/temelyos/mongo-typed.git"
  },
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"./dist",
		"package.json",
		"LICENSE",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./zod": {
			"types": "./dist/zod/index.d.ts",
			"import": "./dist/zod/index.js",
			"default": "./dist/zod/index.js"
		}
	},
	"scripts": {
		"build": "node scripts/build.mjs && tsc --project tsconfig.build.json",
		"deploy": "npm run build && node ./scripts/publish.mjs",
		"lint": "eslint . --c eslint.config.mjs",
		"lint:fix": "eslint . --c eslint.config.mjs --fix",
		"prune": "node scripts/prune.mjs",
    "test": "tsx --tsconfig ./tsconfig.build.json --test \"./src/**/*.{spec,test}.ts\" \"./test/**/*.{spec,test}.ts\""
	},
	"peerDependencies": {
		"zod": "^4.1.0"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		}
	},
	"devDependencies": {
		"@temelyos/eslint-config": "^1.0.38",
		"@temelyos/tsconfig": "^1.0.6",
		"@types/node": "^25.6.0",
		"tsx": "^4.21.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-native": "npm:typescript@^7.0.2",
		"zod": "^4.6.7"
	}
}